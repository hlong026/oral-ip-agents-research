{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "口播IP智能体-本地版",
  "identifier": "com.oralip.desktop.localdev",
  "build": {
    "beforeBuildCommand": ""
  },
  "app": {
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "localdev-remote",
          "description": "本地联调壳加载远程 dev server，需显式授予远程 origin IPC 权限（machine_code 等）",
          "windows": ["main"],
          "remote": { "urls": ["http://localhost:5173"] },
          "permissions": ["core:default"]
        }
      ]
    },
    "windows": [
      {
        "label": "main",
        "title": "口播IP智能体（本地联调）",
        "url": "http://localhost:5173",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"]
  }
}
