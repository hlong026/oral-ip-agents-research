# ===== 用户端 Web 构建变量 =====
# Vite 变量会在构建时写入前端产物，不是运行时秘密；禁止在这里填写任何 API Key 或 Token。
# 修改后必须重启 dev server；生产环境修改后必须重新执行构建。

# 用户 API 根地址，必须包含 /api/v1。
# 本地开发留空或删除本行时走 Vite 代理；远程联调/桌面生产包必须填写用户电脑可访问的 HTTPS 地址。
VITE_API_BASE=https://api.example.com/api/v1

# 任务状态 WebSocket 地址，可选。
# 留空时会从远程 VITE_API_BASE 自动推导：
#   https://api.example.com/api/v1 -> wss://api.example.com/ws/tasks
# 也支持填写 wss://api.example.com、wss://api.example.com/ws 或完整 /ws/tasks 地址。
VITE_WS_BASE=wss://api.example.com/ws

# 抖音私信前端入口开关。当前生产结论为 No-Go，必须保持 false。
# 该值只控制界面显示，不能替代后端 IM_ENABLED 和灰度安全门禁。
VITE_IM_ENABLED=false
