# Tauri 打包时必须注入可从用户电脑访问的后端地址。
# 将本文件复制为 apps/web/.env.local 后再运行 pnpm --filter @oral/desktop tauri:build。
# 远程服务器必须使用 HTTPS/WSS；不要把 Docker 内部地址（如 http://server:8000）写进这里。
VITE_API_BASE=https://api.example.com/api/v1

# 可选；不填时会从远程 VITE_API_BASE 推导为 wss://api.example.com/ws/tasks。
# 支持填写 wss://api.example.com、wss://api.example.com/ws 或完整 wss://api.example.com/ws/tasks。
VITE_WS_BASE=wss://api.example.com/ws
