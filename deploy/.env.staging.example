# Tencent Cloud Staging deployment control plane.
# Copy outside the repository (for example /etc/oral/staging-deploy.env), replace
# every example value, chmod 0600, and never commit real credentials.
DEPLOY_ENVIRONMENT=staging
RELEASE_GIT_COMMIT=REPLACE_WITH_40_HEX_MASTER_COMMIT

# All four release components must use immutable digests from the same release.
ORAL_SERVER_IMAGE=registry.example.com/oral/server@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
ORAL_WEB_IMAGE=registry.example.com/oral/web@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
ORAL_ADMIN_IMAGE=registry.example.com/oral/admin@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
ORAL_GATEWAY_IMAGE=registry.example.com/oral/gateway@sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd

# Runtime and smoke credentials live outside the repository in owner-only files.
ORAL_ENV_FILE=/etc/oral/oral-staging.env
STAGING_SMOKE_ENV_FILE=/etc/oral/staging-smoke.env
STAGING_EVIDENCE_DIR=./.runtime/staging-evidence

WEB_HOST=staging-app.example.com
ADMIN_HOST=staging-admin.example.com
GATEWAY_BIND=127.0.0.1:18080
DEPLOY_READY_URL=https://staging-app.example.com/readyz
STAGING_WEB_URL=https://staging-app.example.com
STAGING_ADMIN_URL=https://staging-admin.example.com
STAGING_API_BASE_URL=https://staging-app.example.com

# Fail-closed resource identity allow-list. Preflight compares the runtime env
# against these non-secret identities before it touches the network.
STAGING_EXPECTED_COS_BUCKET=oral-staging-media-1250000000
STAGING_EXPECTED_DATABASE_HOST=staging-postgres.internal.example
STAGING_EXPECTED_REDIS_HOST=staging-redis.internal.example
STAGING_EXPECTED_MEDIA_HOST=staging-app.example.com

# Minimum host capacity before a Staging deployment is allowed to start.
# Tune upward for production-parity load tests; do not set to zero to bypass a warning.
STAGING_MIN_FREE_DISK_MB=10240
STAGING_MIN_AVAILABLE_MEMORY_MB=2048
STAGING_MIN_FREE_INODES=10000

# Optional Docker network for STG-LITE local dependency containers. Leave empty
# when PostgreSQL/Redis are VPC-managed services reachable through normal routing.
STAGING_DOCKER_NETWORK=

# Keep real publishing disabled during infrastructure bring-up. Enable only for a
# controlled test account after the publish platform has an explicit acceptance case.
STAGING_ALLOW_VERIFIED_PUBLISH=false

WORKER_PROCESSES=1
WORKER_THREADS=1
