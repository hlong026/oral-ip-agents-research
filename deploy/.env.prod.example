# Copy outside the repository and replace every example value before deployment.
# API, Worker and migration must use the exact same immutable server image.
ORAL_SERVER_IMAGE=registry.example.com/oral/server@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
ORAL_WEB_IMAGE=registry.example.com/oral/web@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
ORAL_ADMIN_IMAGE=registry.example.com/oral/admin@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
ORAL_GATEWAY_IMAGE=nginx:1.27-alpine

# For repository CI this points at the checked-in template. Production must use
# an absolute path with mode 0600, for example /etc/oral/oral-prod.env.
ORAL_ENV_FILE=./server/.env.production.example
COS_MIGRATION_ENV_FILE=./deploy/cos-migration.env.example
COS_MIGRATION_STATE_DIR=./.runtime/cos-migration

WEB_HOST=app.example.com
ADMIN_HOST=admin.example.com
# Bind to loopback when Tencent Cloud CLB or a host-level TLS proxy is used.
GATEWAY_BIND=127.0.0.1:18080

WORKER_PROCESSES=2
WORKER_THREADS=1
