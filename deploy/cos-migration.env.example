# Source object storage. Use a read-only migration identity.
SOURCE_S3_ENDPOINT=http://minio.internal:9000
SOURCE_S3_REGION=us-east-1
SOURCE_S3_BUCKET=oral-media
SOURCE_S3_ACCESS_KEY=REPLACE_SOURCE_ACCESS_KEY
SOURCE_S3_SECRET_KEY=REPLACE_SOURCE_SECRET_KEY

# Target values default to S3_* in ORAL_ENV_FILE. Override only when migration
# uses a dedicated target CAM identity.
TARGET_S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
TARGET_S3_REGION=ap-guangzhou
TARGET_S3_BUCKET=oral-media-1250000000
TARGET_S3_ACCESS_KEY=REPLACE_TARGET_CAM_SECRET_ID
TARGET_S3_SECRET_KEY=REPLACE_TARGET_CAM_SECRET_KEY
