# ===== Docker Compose 本机端口配置（可选） =====
# Docker Compose 只会自动读取项目根目录的 .env。
# 本文件仅调整宿主机映射端口；后端业务配置仍放在 server/.env。
# 使用方法：cp .env.example .env。若默认端口未冲突，可以不创建根目录 .env。

# FastAPI 对外端口：http://127.0.0.1:8000
API_PORT=8000
# PostgreSQL 宿主机调试端口；容器之间仍使用 postgres:5432。
POSTGRES_PORT=15432
# Redis 宿主机调试端口；容器之间仍使用 redis:6379。
REDIS_PORT=16379
# MinIO S3 API 端口；容器之间仍使用 minio:9000。
MINIO_API_PORT=19000
# MinIO 管理控制台端口：http://127.0.0.1:19001
MINIO_CONSOLE_PORT=19001
