{
  "name": "@oral/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "口播IP智能体桌面壳（Tauri 2 纯壳，加载 Web 构建产物，算力全在云端）",
  "scripts": {
    "check:release": "node ../../../tools/scripts/check-desktop-release.mjs",
    "check:distribution": "node ../../../tools/scripts/check-desktop-release.mjs --distribution",
    "build:web": "pnpm check:release && pnpm --filter @oral/web build",
    "release:mac": "pnpm check:distribution && pnpm tauri:build --bundles app,dmg",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0"
  }
}
