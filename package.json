{
  "name": "oral-ip-agents",
  "version": "0.1.0",
  "private": true,
  "description": "口播IP智能体 — 口播视频全链路智能体（Monorepo）",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@oral/web",
    "dev:admin": "turbo run dev --filter=@oral/admin",
    "build": "turbo run build",
    "lint": "prettier --check \"client/apps/*/src/**/*.{ts,tsx,js,jsx,mjs,cjs,json}\" \"client/apps/*/package.json\" \"client/apps/desktop-shell/src-tauri/tauri.conf.json\" \"client/packages/*/src/**/*.{ts,tsx,js,jsx,mjs,cjs,json}\" \"client/packages/*/package.json\" \"tools/scripts/*.mjs\" \"tools/e2e/**/*.ts\" \".github/workflows/*.yml\" \"package.json\" \"turbo.json\" \"docs/**/*.md\" \"server/contracts/openapi.snapshot.json\"",
    "typecheck": "turbo run typecheck",
    "test": "node --test tools/scripts/check-desktop-release.test.mjs && turbo run test",
    "gen:api": "node tools/scripts/gen-api-types.mjs",
    "e2e": "playwright test",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.3",
    "turbo": "^2.3.3",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
