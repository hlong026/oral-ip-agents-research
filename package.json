{
  "name": "oral-ip-agents",
  "version": "0.1.0",
  "private": true,
  "description": "口播IP智能体 — 口播视频全链路智能体（Monorepo）",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@oral/web",
    "dev:admin": "turbo run dev --filter=@oral/admin",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "gen:api": "node scripts/gen-api-types.mjs",
    "e2e": "playwright test",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.3",
    "turbo": "^2.3.3",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
