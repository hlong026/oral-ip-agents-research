# ===== 后端本地测试环境 =====
# 用途：手动启动测试 API，或复现 Playwright/后端测试问题。
# 用法：复制为 server/.env.test，再执行：
#   cd server
#   set -a; source .env.test; set +a
#   uv run uvicorn app.main:app --host 127.0.0.1 --port 8000
#
# 注意：pytest 和默认 pnpm e2e 会自动注入隔离变量，正常运行时不需要手动 source 本文件。
# 本模板故意关闭真实 Provider 和 IM，不得填入生产密钥、真实 Cookie 或真实账号。

# -----------------------------------------------------------------------------
# 一、固定测试安全值
# -----------------------------------------------------------------------------

# test 会允许 Mock/降级路径；严禁把该值改成 staging 或 production 后继续使用下列固定密钥。
APP_ENV=test
# 以下值只用于本机测试数据的签名和加密，不具备生产安全性。
APP_SECRET=local-test-app-secret-not-for-production
CONFIG_ENCRYPTION_KEY=local-test-config-key-not-for-production
ACTIVATION_SECRET=local-test-activation-secret-not-for-production
PUBLISH_SESSION_ENCRYPTION_KEY=local-test-publish-session-key-not-for-production
FEIYING_WEBHOOK_SECRET=local-test-webhook-secret-not-for-production

# 测试 API 前缀；应与 Web 测试使用的 /api/v1 保持一致。
API_PREFIX=/api/v1
# 仅允许本机 Web/Admin 开发端口访问。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# -----------------------------------------------------------------------------
# 二、Playwright 初始管理员
# -----------------------------------------------------------------------------

# 仅创建在本地临时/测试数据库中；不得用于任何共享环境。
BOOTSTRAP_ADMIN_PHONE=18800000000
BOOTSTRAP_ADMIN_PASSWORD=E2eAdmin@12345

# -----------------------------------------------------------------------------
# 三、隔离数据层
# -----------------------------------------------------------------------------

# 本地测试 SQLite 文件。需要完全隔离时可改为 /tmp 下的独立绝对路径。
DATABASE_URL=sqlite+aiosqlite:///./test-server.db
# 使用本地目录存储测试媒体，避免接触真实 S3/MinIO 数据。
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage/test

# 故意指向不可达端口，用于验证 Redis 不可用时的进程内通知降级。
# 因此 /healthz 可返回 200，但 /readyz 应返回 503；不要用本模板验证生产就绪状态。
REDIS_URL=redis://127.0.0.1:1/9
# 测试队列名，与开发/生产队列隔离。
TASK_QUEUE_NAME=oral-test

# -----------------------------------------------------------------------------
# 四、外部 Provider 全部关闭
# -----------------------------------------------------------------------------

# 留空表示不允许测试误调用外部计费服务；测试应使用显式 Mock 或失败路径。
DEEPSEEK_API_KEY=
DOUBAO_API_KEY=
YUNWU_API_KEY=
YUNWU_BASE_URL=
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
FEIYING_API_KEY=
PARSE_API_URL=
PARSE_API_KEY=
DOUYIDOU_APP_ID=
DOUYIDOU_APP_SECRET=
DASHSCOPE_API_KEY=

# -----------------------------------------------------------------------------
# 五、发布与 IM 安全边界
# -----------------------------------------------------------------------------

# 测试默认使用无头浏览器；需要真实浏览器回归时再临时设置可执行文件路径。
PUBLISH_BROWSER_HEADLESS=true
PUBLISH_BROWSER_EXECUTABLE_PATH=
# 必须留空：测试环境不能把任何平台标记为“真实验收通过”。
PUBLISH_VERIFIED_PLATFORMS=

# IM 默认关闭。只有专门的本地协议测试可临时通过命令行环境变量开启。
IM_ENABLED=false
DOUYIN_IM_APP_KEY=
# 保留灰度门禁；1000 仅用于避免普通测试受到账号上限干扰，不代表生产配置。
IM_GRAY_ENFORCED=true
IM_GRAY_MAX_ACCOUNTS=1000
