# ===== 后端测试 / Playwright 本地 API 环境 =====
# 用法：复制为 server/.env.test 后，在启动测试 API 的终端中 source 该文件。
# 仅限本地测试。不要将生产 Provider 密钥、Cookie 或真实账号写入此文件。

# 基础与安全：这些是固定测试值，不能用于生产。
APP_ENV=test
APP_SECRET=local-test-app-secret-not-for-production
CONFIG_ENCRYPTION_KEY=local-test-config-key-not-for-production
ACTIVATION_SECRET=local-test-activation-secret-not-for-production
PUBLISH_SESSION_ENCRYPTION_KEY=local-test-publish-session-key-not-for-production
FEIYING_WEBHOOK_SECRET=local-test-webhook-secret-not-for-production
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# 供 Playwright E2E 创建和登录测试管理员使用。
BOOTSTRAP_ADMIN_PHONE=18800000000
BOOTSTRAP_ADMIN_PASSWORD=E2eAdmin@12345

# 不依赖外部服务的本地测试数据层。
DATABASE_URL=sqlite+aiosqlite:///./test-server.db
LOCAL_STORAGE_DIR=./storage/test
STORAGE_DRIVER=local
# Redis 不可用时，测试环境会降级为进程内通知；不要用此配置验证生产就绪状态。
REDIS_URL=redis://127.0.0.1:1/9
TASK_QUEUE_NAME=oral-test

# 所有真实 Provider 保持关闭，测试会使用显式 Mock/失败路径。
DEEPSEEK_API_KEY=
DOUBAO_API_KEY=
YUNWU_API_KEY=
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
FEIYING_API_KEY=
PARSE_API_URL=
PARSE_API_KEY=
DOUYIDOU_APP_ID=
DOUYIDOU_APP_SECRET=
DASHSCOPE_API_KEY=

# 未验收的平台只生成导出包；测试环境不得宣称真实自动发布。
PUBLISH_BROWSER_HEADLESS=true
PUBLISH_VERIFIED_PLATFORMS=

# IM 默认关闭。只在 OpenAPI 契约测试中临时通过命令环境变量开启。
IM_ENABLED=false
DOUYIN_IM_APP_KEY=
IM_GRAY_ENFORCED=true
IM_GRAY_MAX_ACCOUNTS=1000
