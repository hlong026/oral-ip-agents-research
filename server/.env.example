# ===== 口播 IP 智能体后端环境变量模板 =====
# 使用方法：复制为 server/.env，再按部署环境修改。
#
# 书写规则：
# 1. 使用 KEY=value，不要在等号两侧加空格。
# 2. 布尔值统一写 true / false；多个值使用英文逗号分隔。
# 3. 含空格、#、$ 等特殊字符的值应使用单引号包裹。
# 4. 本文件只能保存占位值。真实密码、Token、Cookie、API Key 不得提交到 Git。
# 5. APP_ENV=staging/production 时会执行安全配置校验，缺少必填密钥将拒绝启动。
# 6. Docker Compose 会通过 server/.env 读取业务配置，并覆盖数据库、Redis、S3 等容器地址。

# -----------------------------------------------------------------------------
# 一、运行环境与安全密钥
# -----------------------------------------------------------------------------

# 运行环境：dev=本地开发，test=自动化测试，staging=预发布，production=生产。
# staging/production 禁止使用 Mock Provider，也不会自动 create_all 建表。
APP_ENV=dev

# JWT 签名及通用 HMAC 主密钥。staging/production 必填。
# 建议使用至少 32 字节随机值，例如：openssl rand -hex 32
# 不要与下面四个专用密钥复用。
APP_SECRET=REPLACE_WITH_RANDOM_APP_SECRET

# 管理控制面（/api/admin/v1，aud=admin）JWT 专用签名密钥。staging/production 必填且不得与
# APP_SECRET 复用：用户面密钥泄露时无法伪造管理面令牌。dev/test 留空时从 APP_SECRET 派生。
ADMIN_JWT_SECRET=REPLACE_WITH_RANDOM_ADMIN_JWT_SECRET

# 管理控制面网络层访问控制：逗号分隔的 IP/CIDR 白名单（如 10.0.0.0/8,203.0.113.7）。
# 空 = 不限制（仅限 dev/test）；staging/production 必须配置，否则拒绝启动。
# 仅在直连对端属于受信代理（TRUSTED_PROXY_IPS）时采信 X-Forwarded-For 判定来源。
ADMIN_API_ALLOWED_IPS=

# 受信代理清单：逗号分隔的 IP/CIDR（如 127.0.0.1,10.0.0.0/8）。
# 仅当直连对端属于该清单时才采信 X-Forwarded-For；否则一律使用直连对端 IP，
# 防止公网直连场景下伪造 XFF 绕过管理面白名单 / 登录频控。空 = 不信任任何代理。
# 反向代理部署时务必配置为边缘网关出口地址。
TRUSTED_PROXY_IPS=

# 登录防爆破（用户面与管理面共用阈值）：窗口内允许的最大凭据错误次数。
LOGIN_FAILURE_LIMIT=5
# 失败计数窗口，单位：秒。600 表示统计最近 10 分钟。
LOGIN_RATE_WINDOW_SECONDS=600
# 达到上限后的锁定时长，单位：秒。900 表示锁定 15 分钟。
LOGIN_LOCK_SECONDS=900

# 管理端保存 Provider 配置时使用的加密密钥。staging/production 必填。
# 任意高强度随机字符串均可，程序会派生 Fernet 密钥；更换后旧密文将无法解密。
CONFIG_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_CONFIG_ENCRYPTION_KEY

# 激活码签名、激活频控标识计算所用密钥。staging/production 必填。
# 更换后历史未使用激活码可能无法继续验证。
ACTIVATION_SECRET=REPLACE_WITH_RANDOM_ACTIVATION_SECRET

# 平台账号 Cookie/Session 的数据库加密密钥。staging/production 必填。
# 更换前必须先安排账号重新授权，否则旧登录态将无法解密。
PUBLISH_SESSION_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_PUBLISH_SESSION_KEY

# 飞影 Webhook 回调验签密钥。staging/production 必填，即使暂时仅使用轮询也不能留空。
FEIYING_WEBHOOK_SECRET=REPLACE_WITH_FEIYING_WEBHOOK_SECRET

# 单个手机号/设备在频控窗口内允许的失败次数；达到后进入锁定。
ACTIVATION_FAILURE_LIMIT=5
# 激活失败计数窗口，单位：秒。600 表示统计最近 10 分钟。
ACTIVATION_RATE_WINDOW_SECONDS=600
# 达到失败上限后的锁定时间，单位：秒。900 表示锁定 15 分钟。
ACTIVATION_LOCK_SECONDS=900

# 用户端 API 路由前缀。通常保持 /api/v1；修改后必须同步前端 VITE_API_BASE 和网关。
API_PREFIX=/api/v1

# 允许浏览器跨域访问的前端来源，使用英文逗号分隔，必须包含协议和端口且不能带路径。
# staging/production 未配置时，浏览器跨域请求会被拒绝；不要使用 * 配合 Cookie 鉴权。
# Tauri 桌面包还需保留 tauri://localhost（macOS/Linux）及 tauri.localhost（Windows）。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,tauri://localhost,http://tauri.localhost,https://tauri.localhost

# -----------------------------------------------------------------------------
# 二、首次管理员
# -----------------------------------------------------------------------------

# 仅在数据库中还没有管理员时创建初始管理员；手机号作为登录账号。
# 创建成功后应从部署平台删除这两个变量，避免密码长期留在环境中。
BOOTSTRAP_ADMIN_PHONE=
# 建议至少 12 位并包含大小写字母、数字和符号；禁止使用测试模板中的固定密码。
BOOTSTRAP_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# 三、数据库、Redis 与任务队列
# -----------------------------------------------------------------------------

# SQLAlchemy 异步连接串。
# 本地 SQLite：sqlite+aiosqlite:///./oral.db
# PostgreSQL：postgresql+asyncpg://用户名:密码@主机:5432/数据库名
# 密码含 @、:、/ 等字符时必须先做 URL 编码。
DATABASE_URL=sqlite+aiosqlite:///./oral.db

# Redis 连接串，用于事件广播、Dramatiq 队列、分布式锁和灰度计数。
# staging/production 必须是真实可用的 Redis，不能依赖测试环境的进程内降级。
REDIS_URL=redis://localhost:6379/0

# Dramatiq 队列名称。同一环境的 API 与 Worker 必须一致；不同环境建议使用不同名称。
TASK_QUEUE_NAME=oral

# -----------------------------------------------------------------------------
# 四、媒体与对象存储
# -----------------------------------------------------------------------------

# 存储驱动：local=本地目录，s3=MinIO/AWS S3 兼容对象存储。
# 单机开发可用 local；多实例、容器和预发布/生产应使用 s3。
STORAGE_DRIVER=local

# local 驱动的媒体根目录。相对路径以启动后端时的工作目录为基准。
# API 与 Worker 分进程运行时必须挂载同一个共享目录。
LOCAL_STORAGE_DIR=./storage

# S3/MinIO API 地址，不是控制台地址。
# 本机 MinIO 示例：http://127.0.0.1:19000
# Compose 容器内部示例：http://minio:9000
S3_ENDPOINT=http://localhost:9000
# S3 Access Key。生产环境由密钥管理服务注入。
S3_ACCESS_KEY=oral
# S3 Secret Key。生产环境禁止使用 oral_dev_minio。
S3_SECRET_KEY=oral_dev_minio
# 存放上传、音频、视频、封面和导出包的 Bucket；启动前必须已创建且具备读写权限。
S3_BUCKET=oral-media

# -----------------------------------------------------------------------------
# 五、登录令牌
# -----------------------------------------------------------------------------

# JWT 算法。当前实现按共享密钥设计，保持 HS256；修改前需同步验证兼容性。
JWT_ALGORITHM=HS256
# Access Token 有效期，单位：分钟。越长越方便，泄露后的风险窗口也越长。
ACCESS_TOKEN_TTL_MIN=120
# Refresh Token 有效期，单位：天。
REFRESH_TOKEN_TTL_DAYS=30
# true=同一账号新会话登录后使旧会话失效；false=允许多设备同时在线。
SINGLE_SESSION_KICK=false

# -----------------------------------------------------------------------------
# 六、LLM Provider
# -----------------------------------------------------------------------------

# DeepSeek API Key。真实文案生成必填；也可以在管理端 Provider 设置中加密保存。
DEEPSEEK_API_KEY=
# DeepSeek OpenAI 兼容接口根地址，一般无需修改。
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 文案生成模型名称，必须是当前账号有权调用的模型。
DEEPSEEK_MODEL=deepseek-chat

# 豆包 API Key；仅在选择豆包 Provider 时填写。
DOUBAO_API_KEY=

# 云雾中转 API Key 和接口根地址；仅在使用该中转服务时填写，二者必须同时配置。
YUNWU_API_KEY=
YUNWU_BASE_URL=

# -----------------------------------------------------------------------------
# 七、声音克隆与数字人
# -----------------------------------------------------------------------------

# MiniMax 声音克隆/合成凭据；真实声音链路需要同时配置 Key 和 Group ID。
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# 飞影数字人 API Key；真实数字人提交、查询和结果下载必填。
FEIYING_API_KEY=
# 飞影 API 根地址。除非供应商提供了专属地址，否则保持默认。
FEIYING_BASE_URL=https://hfw-api.hifly.cc
# 飞影任务轮询间隔，单位：秒。过小会增加限流风险。
FEIYING_POLL_INTERVAL=5.0
# 飞影最大轮询次数；与轮询间隔共同决定超时。5 秒 × 60 次约为 5 分钟。
FEIYING_POLL_MAX_ATTEMPTS=60

# -----------------------------------------------------------------------------
# 八、链接解析与 ASR
# -----------------------------------------------------------------------------

# 第三方通用解析服务兜底。留空表示不启用；启用时 URL 和 Key 应同时配置。
PARSE_API_URL=
PARSE_API_KEY=

# Douyidou 抖音/小红书链接解析凭据，申请地址：https://www.douyidou.cc
DOUYIDOU_APP_ID=
DOUYIDOU_APP_SECRET=
# Douyidou 网关地址，一般无需修改。
DOUYIDOU_BASE_URL=https://gateway.diadi.cn

# 阿里云百炼 DashScope Key，真实 Fun-ASR 转写必填。
DASHSCOPE_API_KEY=
# 企业专属 Workspace ID；普通账号或默认业务空间可留空。
DASHSCOPE_WORKSPACE_ID=
# 服务区域：cn-beijing 或 ap-southeast-1，必须与账号和模型开通区域一致。
DASHSCOPE_REGION=cn-beijing
# 长音频异步模型，支持较长媒体。
ASR_MODEL=fun-asr
# 短音频同步模型；模型版本必须是当前区域实际可用值。
ASR_FLASH_MODEL=fun-asr-flash-2026-06-15
# 音频时长小于等于该值时走 Flash 同步转写，单位：秒。
ASR_FLASH_THRESHOLD_SEC=300
# 异步 ASR 查询间隔，单位：秒。
ASR_POLL_INTERVAL=2.0
# 异步 ASR 最大查询次数。2 秒 × 90 次约为 3 分钟。
ASR_POLL_MAX_ATTEMPTS=90

# -----------------------------------------------------------------------------
# 九、流水线与发布
# -----------------------------------------------------------------------------

# 单个 API 进程允许同时执行的流水线任务数；需结合 CPU、内存和 Provider 限额设置。
PIPELINE_MAX_CONCURRENCY=5

# true=无头浏览器，适合服务器/容器；false=显示浏览器窗口，仅适合本机调试。
PUBLISH_BROWSER_HEADLESS=true
# Chromium/Chrome 可执行文件绝对路径。留空时尝试自动探测；容器中为 /usr/bin/chromium。
PUBLISH_BROWSER_EXECUTABLE_PATH=
# 同时占用浏览器执行发布的最大任务数；真实平台初次验收建议从 1 开始。
PUBLISH_MAX_CONCURRENCY=2
# 平台 Cookie 有效性检测间隔，单位：分钟。
PUBLISH_COOKIE_HEARTBEAT_MIN=30
# 已经用真实账号验收通过的平台代码，英文逗号分隔。
# 可用值：douyin、xiaohongshu、shipinhao。未列出的平台只生成手工发布包。
# 本地代码/Mock 测试通过不能作为加入该名单的依据。
PUBLISH_VERIFIED_PLATFORMS=

# -----------------------------------------------------------------------------
# 十、抖音私信 IM（当前生产 No-Go）
# -----------------------------------------------------------------------------

# 私信总开关。当前只能保持 false；staging/production 设置为 true 会被安全门禁拒绝启动。
IM_ENABLED=false
# 抖音 IM 应用 Key。只有取得正式授权并进入受控灰度时才可由密钥服务注入。
DOUYIN_IM_APP_KEY=
# 以下三项是协议标识，除非固定协议版本资料明确要求，否则不要修改。
DOUYIN_IM_AID=6383
DOUYIN_IM_FPID=9
DOUYIN_IM_ACCESS_KEY_SUFFIX=f8a69f1719916z
# 私信历史保留天数；需要与隐私政策、数据删除流程保持一致。
IM_HISTORY_RETENTION_DAYS=90
# 历史消息清理任务执行间隔，单位：小时。
IM_CLEANUP_INTERVAL_HOURS=24
# true=只允许灰度名单中的账号启用 IM；当前必须保持 true。
IM_GRAY_ENFORCED=true
# 允许进入灰度的最大账号数。扩大前必须重新完成风险评审。
IM_GRAY_MAX_ACCOUNTS=20
# IM 连接、发送和风控指标保留天数；必须覆盖七天灰度验收窗口。
IM_METRIC_RETENTION_DAYS=14
