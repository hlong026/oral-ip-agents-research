# ===== 口播IP智能体后端配置（复制为 .env 使用） =====

# 基础
APP_ENV=dev
APP_SECRET=change-me-in-prod-32bytes-min-secret
API_PREFIX=/api/v1

# 数据层（本地开发默认 sqlite + fakeredis 亦可跑通；生产用 docker-compose）
DATABASE_URL=sqlite+aiosqlite:///./oral.db
REDIS_URL=redis://localhost:6379/0

# 对象存储（MinIO/S3；MVP 默认本地文件存储 storage/）
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=oral
S3_SECRET_KEY=oral_dev_minio
S3_BUCKET=oral-media
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage

# JWT（F-601 / C7 双令牌）
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=120
REFRESH_TOKEN_TTL_DAYS=30
SINGLE_SESSION_KICK=false

# LLM（DeepSeek 主力 / 豆包 / 云雾中转）
# 注：以下凭据也可通过前端设置页配置（保存即时生效，无需重启）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DOUBAO_API_KEY=
YUNWU_API_KEY=
YUNWU_BASE_URL=

# MiniMax 声音（Voice 主力）
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# 飞影数字人（Avatar MVP 主力）
FEIYING_API_KEY=
FEIYING_BASE_URL=

# 第三方解析 API 兜底（可选）
PARSE_API_URL=
PARSE_API_KEY=

# Douyidou 视频解析（抖音/小红书去水印 + 文案提取）
# 申请地址：https://www.douyidou.cc
DOUYIDOU_APP_ID=
DOUYIDOU_APP_SECRET=
DOUYIDOU_BASE_URL=https://gateway.diadi.cn

# 阿里云 Fun-ASR 语音转写（DashScope）
# 申请地址：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
ASR_MODEL=fun-asr
ASR_FLASH_MODEL=fun-asr-flash-2026-06-15
ASR_FLASH_THRESHOLD_SEC=300
ASR_POLL_INTERVAL=2.0
ASR_POLL_MAX_ATTEMPTS=90

# 并发闸门（F-406：任务级并发 ≥5）
PIPELINE_MAX_CONCURRENCY=5

# 发布模块（social-auto-upload 浏览器自动化）
PUBLISH_BROWSER_HEADLESS=true
PUBLISH_BROWSER_EXECUTABLE_PATH=
PUBLISH_MAX_CONCURRENCY=2
PUBLISH_COOKIE_HEARTBEAT_MIN=30

# 抖音 IM：生产环境保持 false；仅本地演示/自动化测试可开启 Mock
DOUYIN_IM_USE_MOCK=false
DOUYIN_IM_APP_KEY=e1bd35ec9db7b8d846de66ed140b1ad9
DOUYIN_IM_AID=6383
DOUYIN_IM_FPID=9
DOUYIN_IM_ACCESS_KEY_SUFFIX=f8a69f1719916z
DOUYIN_IM_BROWSER_ENABLED=true
DOUYIN_IM_BROWSER_TIMEOUT_SEC=120
DOUYIN_IM_BROWSER_TIMEOUT_MS=60000
DOUYIN_IM_BROWSER_SYNC_INTERVAL_SEC=300
