# ===== 口播IP智能体后端配置（复制为 .env 使用） =====

# 基础
APP_ENV=dev
APP_SECRET=change-me-in-prod-32bytes-min-secret
# 生产环境必须分别设置以下不同用途的高强度密钥
CONFIG_ENCRYPTION_KEY=change-me-provider-config-encryption-key
ACTIVATION_SECRET=change-me-activation-code-hmac-key
PUBLISH_SESSION_ENCRYPTION_KEY=change-me-publish-session-encryption-key
ACTIVATION_FAILURE_LIMIT=5
ACTIVATION_RATE_WINDOW_SECONDS=600
ACTIVATION_LOCK_SECONDS=900
API_PREFIX=/api/v1
# 非 dev 环境必填；本地 dev 会自动使用 localhost 白名单
CORS_ORIGINS=

# 首次启动管理员（创建成功后应从部署环境中删除密码）
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=

# 数据层（本地开发默认 sqlite + fakeredis 亦可跑通；生产用 docker-compose）
DATABASE_URL=sqlite+aiosqlite:///./oral.db
REDIS_URL=redis://localhost:6379/0
TASK_QUEUE_NAME=oral
REDIS_OPERATION_TIMEOUT_SECONDS=3

# 对象存储（MinIO/S3）
# 端口说明：docker-compose 把 MinIO 的 9000 映射到宿主机 19000。
#   - 后端以「本地进程」运行时，S3_ENDPOINT 用宿主机映射端口 http://localhost:19000
#   - 后端在 docker-compose 的 server 容器内运行时，改用容器网络地址 http://minio:9000
S3_ENDPOINT=http://localhost:19000
S3_ACCESS_KEY=oral
S3_SECRET_KEY=oral_dev_minio
S3_BUCKET=oral-media
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=virtual
S3_SIGNATURE_VERSION=s3
S3_MAX_POOL_CONNECTIONS=32
S3_CONNECT_TIMEOUT_SECONDS=5
S3_READ_TIMEOUT_SECONDS=60
S3_MAX_ATTEMPTS=4
S3_MULTIPART_THRESHOLD_MB=64
S3_MULTIPART_CHUNKSIZE_MB=16
# 存储驱动：local | s3
# 注意：local 驱动把媒体写到 LOCAL_STORAGE_DIR（宿主机普通目录），
#   工作区清理/重建会导致文件丢失、数据库 key 变成死链（分身预览/成片 404）。
#   本地开发若需媒体持久化，改用 s3 驱动落到带持久卷的 MinIO（需先创建 S3_BUCKET）。
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
# 真实云端 ASR 必填：该地址的 /media/* 必须能被阿里云等外部 Provider 下载。
MEDIA_PUBLIC_BASE_URL=

# JWT（F-601 / C7 双令牌）
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=120
REFRESH_TOKEN_TTL_DAYS=30
SINGLE_SESSION_KICK=false

# LLM（DeepSeek 主力 / 豆包 / 云雾中转）
# 凭据仅允许由管理端配置或通过服务端环境变量注入，禁止发往用户端。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DOUBAO_API_KEY=
YUNWU_API_KEY=
YUNWU_BASE_URL=

# MiniMax 声音（Voice 主力）
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# 飞影数字人（Avatar MVP 主力）
FEIYING_API_KEY=
FEIYING_BASE_URL=
FEIYING_WEBHOOK_SECRET=
WEBHOOK_RETRY_MAX_ATTEMPTS=3
WEBHOOK_RETRY_BASE_SECONDS=30

# 第三方解析 API 兜底（可选）
PARSE_API_URL=
PARSE_API_KEY=

# Douyidou 视频解析（抖音/小红书去水印 + 文案提取）
# 申请地址：https://www.douyidou.cc
DOUYIDOU_APP_ID=
DOUYIDOU_APP_SECRET=
DOUYIDOU_BASE_URL=https://gateway.diadi.cn

# 阿里云 Fun-ASR 语音转写（DashScope）
# 申请地址：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
ASR_MODEL=fun-asr
ASR_FLASH_MODEL=fun-asr-flash-2026-06-15
ASR_FLASH_THRESHOLD_SEC=300
ASR_POLL_INTERVAL=2.0
ASR_POLL_MAX_ATTEMPTS=90

# 并发闸门（F-406：任务级并发 ≥5）
PIPELINE_MAX_CONCURRENCY=5
# 真实验收时必须设为 false，避免真实 Provider 失败后由 Mock 产物掩盖。
PROVIDER_MOCK_FALLBACK_ENABLED=true

# 发布模块（social-auto-upload 浏览器自动化）
PUBLISH_BROWSER_HEADLESS=false
PUBLISH_BROWSER_EXECUTABLE_PATH=
PUBLISH_MAX_CONCURRENCY=2
PUBLISH_COOKIE_HEARTBEAT_MIN=30
# 真实账号验收通过后再逐个平台加入，例如 douyin；未列出平台只允许导出人工发布包。
PUBLISH_VERIFIED_PLATFORMS=

# 抖音 IM 私信：S3-01 当前为 No-Go，仅开发/测试预研可启用；非开发环境会拒绝启动。
IM_ENABLED=false
DOUYIN_IM_APP_KEY=
DOUYIN_IM_AID=6383
DOUYIN_IM_FPID=9
DOUYIN_IM_ACCESS_KEY_SUFFIX=f8a69f1719916z
IM_HISTORY_RETENTION_DAYS=90
IM_CLEANUP_INTERVAL_HOURS=24
IM_GRAY_ENFORCED=true
IM_GRAY_MAX_ACCOUNTS=20
IM_METRIC_RETENTION_DAYS=14
