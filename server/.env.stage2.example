# ===== 第二阶段真实主链验收环境 =====
# 目标：验证“授权链接/固定正文 -> 真实 Provider -> MP4 -> 平台发布或人工发布包”。
# 用法：复制为未跟踪的 server/.env.stage2，在受控预发布终端中执行：
#   set -a; source server/.env.stage2; set +a
#   uv run --directory server python scripts/stage2_acceptance.py
#
# 所有 REPLACE_* 必须由密钥管理服务、CI Secret 或部署平台注入，禁止提交真实值。
# 验收至少连续运行 3 次；本模板始终保持 IM_ENABLED=false。

# -----------------------------------------------------------------------------
# 一、预发布安全配置（全部必填）
# -----------------------------------------------------------------------------

# 必须是 staging。不要使用 dev/test，否则可能误走 Mock；不要直接指向 production 数据。
APP_ENV=staging
# 五个安全密钥必须彼此不同，建议分别执行 openssl rand -hex 32 生成。
APP_SECRET=REPLACE_WITH_STAGING_APP_SECRET
CONFIG_ENCRYPTION_KEY=REPLACE_WITH_STAGING_CONFIG_ENCRYPTION_KEY
ACTIVATION_SECRET=REPLACE_WITH_STAGING_ACTIVATION_SECRET
PUBLISH_SESSION_ENCRYPTION_KEY=REPLACE_WITH_STAGING_PUBLISH_SESSION_KEY
FEIYING_WEBHOOK_SECRET=REPLACE_WITH_STAGING_FEIYING_WEBHOOK_SECRET

# 用户端 API 前缀，一般保持默认。
API_PREFIX=/api/v1
# 只填写本轮预发布 Web 的真实 Origin，不带路径；多个 Origin 使用英文逗号分隔。
CORS_ORIGINS=https://REPLACE_WITH_STAGING_WEB_ORIGIN

# -----------------------------------------------------------------------------
# 二、真实预发布基础设施（全部必填）
# -----------------------------------------------------------------------------

# PostgreSQL 异步连接串，例如：postgresql+asyncpg://user:encoded_password@db:5432/oral_stage
DATABASE_URL=REPLACE_WITH_STAGING_DATABASE_URL
# 必须可被 API 和 Worker 同时访问，不允许使用测试模板中的不可达 Redis。
REDIS_URL=REPLACE_WITH_STAGING_REDIS_URL
# 预发布独立队列名，避免消费开发或生产任务。
TASK_QUEUE_NAME=oral-staging

# 第二阶段必须使用真实 S3/MinIO，验证 API、Worker 和发布模块跨进程共享媒体。
STORAGE_DRIVER=s3
# S3 API 地址，不是管理控制台地址。
S3_ENDPOINT=REPLACE_WITH_STAGING_S3_ENDPOINT
S3_ACCESS_KEY=REPLACE_WITH_STAGING_S3_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_STAGING_S3_SECRET_KEY
# 使用独立预发布 Bucket，不得复用生产 Bucket。
S3_BUCKET=REPLACE_WITH_STAGING_S3_BUCKET

# -----------------------------------------------------------------------------
# 三、真实 Provider 凭据
# -----------------------------------------------------------------------------

# 文案生成。Key 必须属于已批准的验收账号，并设置费用限额。
DEEPSEEK_API_KEY=REPLACE_WITH_DEEPSEEK_API_KEY

# 声音克隆/合成，Key 和 Group ID 必须来自同一 MiniMax 账号。
MINIMAX_API_KEY=REPLACE_WITH_MINIMAX_API_KEY
MINIMAX_GROUP_ID=REPLACE_WITH_MINIMAX_GROUP_ID

# 飞影数字人。Base URL 仅在供应商提供专属域名时修改。
FEIYING_API_KEY=REPLACE_WITH_FEIYING_API_KEY
FEIYING_BASE_URL=https://hfw-api.hifly.cc

# Douyidou 链接解析，App ID 与 Secret 必须成对配置。
DOUYIDOU_APP_ID=REPLACE_WITH_DOUYIDOU_APP_ID
DOUYIDOU_APP_SECRET=REPLACE_WITH_DOUYIDOU_APP_SECRET

# 阿里云 Fun-ASR 转写凭据；模型开通区域应与服务端配置一致。
DASHSCOPE_API_KEY=REPLACE_WITH_DASHSCOPE_API_KEY

# -----------------------------------------------------------------------------
# 四、浏览器发布门禁
# -----------------------------------------------------------------------------

# 预发布服务器/容器使用无头模式。
PUBLISH_BROWSER_HEADLESS=true
# 容器通常为 /usr/bin/chromium；留空时由程序自动探测。
PUBLISH_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
# 第一次真实验收只跑一个浏览器并发，降低账号风控和资源竞争风险。
PUBLISH_MAX_CONCURRENCY=1
# 只有本轮已用真实账号发布成功的平台才能填写。
# 可用值：douyin、xiaohongshu、shipinhao；多个值使用英文逗号分隔。
# 留空时所有平台均输出人工发布包，不会宣称自动发布成功。
PUBLISH_VERIFIED_PLATFORMS=

# 第二阶段禁止启用抖音私信；设置为 true 会破坏阶段边界。
IM_ENABLED=false

# -----------------------------------------------------------------------------
# 五、stage2_acceptance.py 验收输入
# -----------------------------------------------------------------------------

# 验收 API 根地址，必须包含 /api/v1；默认本机值仅适用于端口转发场景。
STAGE2_API_BASE=http://127.0.0.1:8000/api/v1

# 短期测试用户 Access Token。必须有足够积分，验收后立即撤销；脚本不会把 Token 写入证据。
STAGE2_ACCESS_TOKEN=REPLACE_WITH_SHORT_LIVED_TEST_USER_TOKEN
# 已完成配置并处于可用状态的 IP 资产 ID。
STAGE2_IP_ID=REPLACE_WITH_READY_IP_ID
# 已训练、试听并确认通过的声音资产 ID。
STAGE2_VOICE_ID=REPLACE_WITH_READY_VOICE_ID
# 已获授权且状态为可用的数字人资产 ID。
STAGE2_AVATAR_ID=REPLACE_WITH_READY_AVATAR_ID
# 固定、已获内容使用授权、在验收期间可稳定访问的视频链接。
STAGE2_REAL_LINK=REPLACE_WITH_FIXED_AUTHORIZED_LINK
# 目标平台代码。即使填写平台，未加入 PUBLISH_VERIFIED_PLATFORMS 时仍只生成发布包。
STAGE2_PLATFORM=douyin
