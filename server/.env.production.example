# ===== 口播IP智能体后端 · 生产环境配置基线（复制为 .env 使用） =====
# 切生产四步验证：环境变量 → 供应商 Key → 管理端开关 → GET /readyz 确认 provider_mode=real_only
# 详见 docs/16-生产切换上线检查清单.md

# 基础（APP_ENV=prod 触发：零 Mock 启动自检 / 安全密钥强校验 / 迁移版本校验）
APP_ENV=prod
# 以下四把密钥必须分别设置为互不相同的高强度随机值（≥32 字节），缺一拒绝启动
APP_SECRET=REPLACE_WITH_32BYTES_RANDOM_SECRET
CONFIG_ENCRYPTION_KEY=REPLACE_WITH_PROVIDER_CONFIG_ENCRYPTION_KEY
ACTIVATION_SECRET=REPLACE_WITH_ACTIVATION_CODE_HMAC_KEY
PUBLISH_SESSION_ENCRYPTION_KEY=REPLACE_WITH_PUBLISH_SESSION_ENCRYPTION_KEY
FEIYING_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SIGNATURE_SECRET
ACTIVATION_FAILURE_LIMIT=5
ACTIVATION_RATE_WINDOW_SECONDS=600
ACTIVATION_LOCK_SECONDS=900
API_PREFIX=/api/v1

# 首次启动管理员（创建成功后必须从部署环境中删除密码）
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=

# 跨域（生产必填：前端正式域名，逗号分隔）
CORS_ORIGINS=https://app.example.com,https://admin.example.com

# 数据层（生产使用 PostgreSQL + Redis，禁止 sqlite/fakeredis）
DATABASE_URL=postgresql+asyncpg://oral:REPLACE_PASSWORD@db:5432/oral
REDIS_URL=redis://redis:6379/0
TASK_QUEUE_NAME=oral

# 对象存储（生产建议 s3/MinIO；MEDIA_PUBLIC_BASE_URL 必须公网可达，云端 ASR 依赖回源下载）
STORAGE_DRIVER=s3
S3_ENDPOINT=https://minio.example.com
S3_ACCESS_KEY=REPLACE_S3_ACCESS_KEY
S3_SECRET_KEY=REPLACE_S3_SECRET_KEY
S3_BUCKET=oral-media
LOCAL_STORAGE_DIR=./storage
MEDIA_PUBLIC_BASE_URL=https://api.example.com

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=120
REFRESH_TOKEN_TTL_DAYS=30
SINGLE_SESSION_KICK=false

# ===== 供应商真实密钥（推荐通过管理端"Provider 配置"页录入并加密落库；.env 仅作迁移期回退）=====
# LLM（DeepSeek）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 飞影数字人/声音
FEIYING_API_KEY=
FEIYING_BASE_URL=https://hfw-api.hifly.cc

# Douyidou 视频解析
DOUYIDOU_APP_ID=
DOUYIDOU_APP_SECRET=
DOUYIDOU_BASE_URL=https://gateway.diadi.cn

# 阿里云 Fun-ASR 语音转写（DashScope）
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
ASR_MODEL=fun-asr
ASR_FLASH_MODEL=fun-asr-flash-2026-06-15
ASR_FLASH_THRESHOLD_SEC=300
ASR_POLL_INTERVAL=2.0
ASR_POLL_MAX_ATTEMPTS=90

# 第三方解析 API 兜底（可选，未接入保持为空）
PARSE_API_URL=
PARSE_API_KEY=

# 并发闸门
PIPELINE_MAX_CONCURRENCY=5
# 生产环境 Mock 降级被代码层强制关闭（按环境推导），此处显式声明仅作双保险
PROVIDER_MOCK_FALLBACK_ENABLED=false

# 发布模块（social-auto-upload 浏览器自动化；服务器环境必须无头）
PUBLISH_BROWSER_HEADLESS=true
PUBLISH_BROWSER_EXECUTABLE_PATH=
PUBLISH_MAX_CONCURRENCY=2
PUBLISH_COOKIE_HEARTBEAT_MIN=30
# 仅列出已用真实账号在 staging 验收通过的平台（例如 douyin,xiaohongshu）；未列出平台只提供人工发布包
PUBLISH_VERIFIED_PLATFORMS=

# 抖音 IM 私信：合规结论 No-Go，生产必须保持 false（开启会拒绝启动）
IM_ENABLED=false
DOUYIN_IM_APP_KEY=
