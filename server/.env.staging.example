# ===== 口播IP智能体后端 · 腾讯云 Staging 配置模板 =====
# 复制到 Staging 服务器私有路径并 chmod 0600。所有 REPLACE_* 均必须替换。
# APP_ENV=staging 会进入与 production 相同的 fail-closed 安全校验：禁止 Mock、SQLite、local storage。
APP_ENV=staging
APP_SECRET=REPLACE_WITH_32BYTES_RANDOM_STAGING_SECRET
CONFIG_ENCRYPTION_KEY=REPLACE_WITH_STAGING_PROVIDER_CONFIG_ENCRYPTION_KEY
ACTIVATION_SECRET=REPLACE_WITH_STAGING_ACTIVATION_HMAC_KEY
PUBLISH_SESSION_ENCRYPTION_KEY=REPLACE_WITH_STAGING_PUBLISH_SESSION_KEY
FEIYING_WEBHOOK_SECRET=REPLACE_WITH_STAGING_WEBHOOK_SIGNATURE_SECRET
ACTIVATION_FAILURE_LIMIT=5
ACTIVATION_RATE_WINDOW_SECONDS=600
ACTIVATION_LOCK_SECONDS=900
API_PREFIX=/api/v1

BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=

CORS_ORIGINS=https://staging-app.example.com,https://staging-admin.example.com,tauri://localhost,https://tauri.localhost

# Staging must use PostgreSQL and Redis. Replace with dedicated Staging resources.
DATABASE_URL=postgresql+asyncpg://oral_staging:REPLACE_PASSWORD@staging-postgres.internal.example:5432/oral_staging
REDIS_URL=redis://:REPLACE_PASSWORD@staging-redis.internal.example:6379/0
TASK_QUEUE_NAME=oral-staging
REDIS_OPERATION_TIMEOUT_SECONDS=3

# Tencent Cloud COS. Bucket must be the full BucketName-APPID and must not be the Production bucket.
STORAGE_DRIVER=s3
S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
S3_ACCESS_KEY=REPLACE_WITH_STAGING_CAM_SECRET_ID
S3_SECRET_KEY=REPLACE_WITH_32BYTES_STAGING_CAM_SECRET_KEY
S3_BUCKET=oral-staging-media-1250000000
S3_REGION=ap-guangzhou
S3_ADDRESSING_STYLE=virtual
S3_SIGNATURE_VERSION=s3
S3_MAX_POOL_CONNECTIONS=16
S3_CONNECT_TIMEOUT_SECONDS=5
S3_READ_TIMEOUT_SECONDS=60
S3_MAX_ATTEMPTS=4
S3_MULTIPART_THRESHOLD_MB=64
S3_MULTIPART_CHUNKSIZE_MB=16
LOCAL_STORAGE_DIR=./storage
MEDIA_PUBLIC_BASE_URL=https://staging-app.example.com

JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=120
REFRESH_TOKEN_TTL_DAYS=7
SINGLE_SESSION_KICK=false

# Real providers use test/staging credentials only. Empty credentials must fail at the feature boundary rather than fall back to Mock.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

FEIYING_API_KEY=
FEIYING_BASE_URL=https://hfw-api.hifly.cc
WEBHOOK_RETRY_MAX_ATTEMPTS=3
WEBHOOK_RETRY_BASE_SECONDS=30

DOUYIDOU_APP_ID=
DOUYIDOU_APP_SECRET=
DOUYIDOU_BASE_URL=https://gateway.diadi.cn

DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
ASR_MODEL=fun-asr
ASR_FLASH_MODEL=fun-asr-flash-2026-06-15
ASR_FLASH_THRESHOLD_SEC=300
ASR_POLL_INTERVAL=2.0
ASR_POLL_MAX_ATTEMPTS=90

PARSE_API_URL=
PARSE_API_KEY=

# Keep Staging low-concurrency until resource and billing recovery tests pass.
PIPELINE_MAX_CONCURRENCY=1
PROVIDER_MOCK_FALLBACK_ENABLED=false

PUBLISH_BROWSER_HEADLESS=true
PUBLISH_BROWSER_EXECUTABLE_PATH=
PUBLISH_MAX_CONCURRENCY=1
PUBLISH_COOKIE_HEARTBEAT_MIN=30
# Keep empty during infrastructure bring-up. Add only a platform that has a dedicated test account and acceptance evidence.
PUBLISH_VERIFIED_PLATFORMS=
PUBLISH_FORCE_REAL=false

# IM remains disabled by default; no production account/session may be reused in Staging.
IM_ENABLED=false
DOUYIN_IM_APP_KEY=
